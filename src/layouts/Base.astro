---
import '../styles/global.css';
import '../styles/legal.css';
import '../styles/people.css';
const {title='Ripples',description='A network where the currency is usefulness.'}=Astro.props;
const path=Astro.url.pathname;
const nav=[['People','/people'],['Ideas','/ideas'],['Podcast','/podcast'],['Events','/events'],['About','/about']];
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#071422"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={Astro.url}/><meta name="twitter:card" content="summary"/><link rel="icon" href="/assets/ripples-icon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/><title>{title}</title></head><body><header class="site-header"><a class="brand" href="/" aria-label="Ripples home"><img src="/assets/ripples-lockup.svg" alt="Ripples"/></a><button class="menu" aria-label="Open menu" aria-expanded="false">Menu</button><nav aria-label="Main navigation">{nav.map(([label,href])=><a class:list={{active:path.startsWith(href)}} href={href}>{label}</a>)}<a class="button small" href="/join">Join the Ripple</a></nav></header><main><slot /></main><footer><div class="footer-mark"><img src="/assets/ripples-lockup.svg" alt="Ripples"/><p>Interesting people. Better questions.<br/>Useful things worth passing on.</p></div><div><p class="eyebrow">The philosophy</p><p>Help because you can.<br/>Make the next interaction count.<br/>Act with integrity.<br/>Trust the ripples.</p></div><div><p class="eyebrow">Follow</p><a href="https://instagram.com/join.theripple" rel="me">Instagram</a><a href="/contact">Contact via Ripples</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div><p class="copyright">© {new Date().getFullYear()} Ripples</p></footer><script>const b=document.querySelector('.menu');const n=document.querySelector('nav');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));n?.classList.toggle('open',!open)});</script></body></html>
