---
import '../styles/global.css';
import '../styles/legal.css';
import '../styles/people.css';
import '../styles/next.css';
const { title='Ripples', description='A network where the currency is usefulness.', image='/images/ripples-social.png' }=Astro.props;
const site='https://jointheripple.com.au';
const pathname=Astro.url.pathname==='/'?'/':`${Astro.url.pathname.replace(/\/$/,'')}/`;
const canonical=new URL(pathname,site);
const socialImage=new URL(image,site);
const path=Astro.url.pathname;
const nav=[['People','/people/'],['Ideas','/ideas/'],['Conversations','/podcast/'],['About','/about/']];
---
<!doctype html><html lang="en-AU"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content={description}/><meta name="theme-color" content="#071422"/><meta name="referrer" content="strict-origin-when-cross-origin"/>
<link rel="canonical" href={canonical}/><meta property="og:site_name" content="Ripples"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/>
<link rel="icon" href="/assets/ripples-icon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/><title>{title}</title>
</head><body><a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><a class="brand" href="/" aria-label="Ripples home"><img src="/assets/ripples-lockup.svg" alt="Ripples"/></a><button class="menu" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav"><span></span></button><nav id="main-nav" aria-label="Main navigation">{nav.map(([label,href])=><a class:list={{active:path.startsWith(href)}} href={href}>{label}</a>)}<a class="button small" href="/join/">Join the Ripple</a></nav></header>
<main id="main"><slot /></main>
<footer><div class="footer-mark"><img src="/assets/ripples-lockup.svg" alt="Ripples"/><p>Interesting people. Better questions.<br/>Useful things worth passing on.</p></div><div><p class="footer-label">The philosophy</p><p>Help because you can.<br/>Make the next interaction count.<br/>Act with integrity.<br/>Trust the ripples.</p></div><div><p class="footer-label">Explore</p><a href="/people/">People</a><a href="/ideas/">Ideas</a><a href="/podcast/">Conversations</a><a href="/contact/">Contact</a></div><div><p class="footer-label">Follow</p><a href="https://instagram.com/join.theripple" rel="me">Instagram</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div><p class="copyright">© {new Date().getFullYear()} Ripples. Operated by Double You Anchor Corporation Pty Ltd.</p></footer>
<script>const button=document.querySelector<HTMLButtonElement>('.menu');const nav=document.querySelector<HTMLElement>('#main-nav');const close=()=>{button?.setAttribute('aria-expanded','false');nav?.classList.remove('open');document.body.classList.remove('menu-open')};button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open);document.body.classList.toggle('menu-open',!open)});nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));document.addEventListener('keydown',event=>{if(event.key==='Escape')close()});</script>
</body></html>
