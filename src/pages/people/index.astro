---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NextBand from '../../components/NextBand.astro';
const people = (await getCollection('people')).filter((person) => person.data.published);
---
<Base title="People | Ripples" description="Meet people through how they can help, what they are curious about and what they want to learn.">
  <section class="page-head">
    <p class="eyebrow">The network</p>
    <h1>People are more than <em>what they do.</em></h1>
    <p class="lede">Discover people through what they can share, what they are learning and the useful interactions they are open to.</p>
  </section>
  <section class="filter-preview" aria-label="Find people by what they can help with">
    <label for="help">I could use someone who understands…</label>
    <div><input id="help" type="search" placeholder="hospitality, business development, AI workflows…" /><button type="button" id="clear-search">Clear</button></div>
    <p>Search what someone can help with, what they are curious about or what they are learning.</p>
  </section>
  <section class="people-list" aria-label="People in the Ripples network">
    {people.map((person) => (
      <a class="person-card" href={`/people/${person.id}/`} data-search={JSON.stringify(person.data).toLowerCase()}>
        {person.data.photo && <img src={person.data.photo} alt={person.data.name} />}
        <div>
          <p class="eyebrow">{person.data.location}</p>
          <h2>{person.data.name}</h2>
          <p>{person.data.intro}</p>
          <span>Meet {person.data.name} →</span>
        </div>
      </a>
    ))}
  </section>
  <p class="search-empty" id="search-empty" hidden>Nobody here matches that yet. <a href="/join/">You may be the first person who can help with it.</a></p>
  <NextBand title="Put your hand up." body="Tell Ripples what you can genuinely help with, what you are curious about and what could help you." href="/join/" link="Join the Ripple"/>
  <script>const input=document.querySelector<HTMLInputElement>('#help');const cards=[...document.querySelectorAll<HTMLElement>('.person-card')];const empty=document.querySelector<HTMLElement>('#search-empty');const filter=()=>{const query=input?.value.trim().toLowerCase()||'';let shown=0;cards.forEach(card=>{const match=!query||(card.dataset.search||'').includes(query)||(card.textContent||'').toLowerCase().includes(query);card.hidden=!match;if(match)shown++});if(empty)empty.hidden=shown>0};input?.addEventListener('input',filter);document.querySelector('#clear-search')?.addEventListener('click',()=>{if(input){input.value='';filter();input.focus()}});</script>
</Base>
